{
  "name": "fullstack-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/runtime.mjs && node scripts/example-assets.mjs",
    "build": "node scripts/runtime.mjs && node scripts/example-assets.mjs && tsc -b && vite build && node scripts/offline.mjs && node scripts/verify-content-assets.mjs",
    "verify:content-assets": "node scripts/verify-content-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "sources:sync": "node scripts/react-sources.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.0",
    "lucide-react": "^0.468.0",
    "prismjs": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^22.20.5",
    "@types/prismjs": "1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
