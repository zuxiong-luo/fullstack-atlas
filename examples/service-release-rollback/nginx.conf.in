daemon off;
worker_processes 1;
worker_shutdown_timeout 8s;
pid @ROOT@/nginx.pid;
error_log @ROOT@/nginx-error.log notice;
events { worker_connections 32; }
http {
  access_log off;
  client_max_body_size 1k;
  upstream notes { server 127.0.0.1:@BACKEND@; }
  server {
    listen 127.0.0.1:@FRONT@;
    add_header X-Atlas-Worker $pid always;
    location / {
      proxy_pass http://notes;
      proxy_http_version 1.1;
      proxy_set_header Connection close;
      proxy_connect_timeout 1s;
      proxy_read_timeout 7s;
      proxy_send_timeout 2s;
    }
  }
}
