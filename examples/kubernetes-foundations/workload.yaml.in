apiVersion: apps/v1
kind: Deployment
metadata:
  name: notes
spec:
  replicas: 2
  minReadySeconds: 1
  progressDeadlineSeconds: 20
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels: { app: atlas-notes }
  template:
    metadata:
      labels: { app: atlas-notes }
    spec:
      terminationGracePeriodSeconds: 3
      securityContext:
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
      containers:
        - name: notes
          image: "@IMAGE@"
          imagePullPolicy: Never
          env:
            - { name: APP_VERSION, value: v1 }
            - { name: APP_READY, value: "1" }
          ports:
            - { name: http, containerPort: 8080 }
          resources:
            requests: { cpu: 50m, memory: 64Mi }
            limits: { cpu: 250m, memory: 128Mi }
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          startupProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 1
            failureThreshold: 30
          readinessProbe:
            httpGet: { path: /ready, port: http }
            periodSeconds: 1
            failureThreshold: 1
          livenessProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 2
            failureThreshold: 2
          volumeMounts:
            - { name: data, mountPath: /data }
            - { name: temporary, mountPath: /tmp }
      volumes:
        - name: data
          emptyDir: { sizeLimit: 16Mi }
        - name: temporary
          emptyDir: { sizeLimit: 8Mi }
---
apiVersion: v1
kind: Service
metadata:
  name: notes
spec:
  selector: { app: atlas-notes }
  ports:
    - { name: http, port: 8080, targetPort: http }
