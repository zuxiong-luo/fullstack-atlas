{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "atlas-debug",
    "namespace": "atlas-debug-lab"
  },
  "spec": {
    "ingressClassName": "REPLACE_WITH_INSTALLED_CLASS",
    "rules": [
      {
        "host": "atlas-debug.test",
        "http": {
          "paths": [
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "atlas-debug",
                  "port": {
                    "number": 80
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
