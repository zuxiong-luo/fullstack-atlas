{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zuxiong-luo.github.io/fullstack-atlas/downloads/agent-workshop/shared/schema.json",
  "$comment": "Validate normalized input: trim question and document text before length checks. Unique document IDs and citations belonging to supplied documents require application validation. Trim follows ECMAScript String.trim; count Unicode code points. Answer is normalized too.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "question",
        "documents"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$(?![\\s\\S])"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "modelResult": {
      "type": "object",
      "required": [
        "answer",
        "citations"
      ],
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
